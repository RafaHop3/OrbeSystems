        "commands": [
            "echo 'Checking current memory...'",
            "free -m",
            "sudo swapoff /swapfile || true",
            "sudo rm -f /swapfile",
            "sudo dd if=/dev/zero of=/swapfile bs=1M count=1024",
            "sudo chmod 600 /swapfile",
            "sudo mkswap /swapfile",
            "sudo swapon /swapfile",
            "echo 'Memory after swap...'",
            "free -m",
            "swapon --show"
        ]
    }
