{
  "schemaVersion": "2.2",
  "description": "Add STRIPE_SECRET_KEY to backend environment",
  "parameters": {
    "commands": [
      {
        "name": "addStripeKey",
        "documentVersion": "$DEFAULT",
        "parameters": {
          "commands": [
            "cd /home/ubuntu/OrbeSystems/backend",
            "echo 'STRIPE_SECRET_KEY=sk_test_SECURE_PLACEHOLDER_KEY' >> .env",
            "echo 'STRIPE_WEBHOOK_SECRET=whsec_SECURE_PLACEHOLDER_KEY' >> .env",
            "echo 'STRIPE_PREMIUM_PRICE_ID=price_1TZgUlFfd0YCJr8gB8d08Rfu' >> .env",
            "docker-compose restart backend"
          ]
        }
      }
    ]
  }
}
