###############################################################################
# k8s/api-secrets.yaml — Template for Kubernetes Secret
# USAGE:
#   1. Copy this file and replace <BASE64_VALUE> with: echo -n "yourvalue" | base64
#   2. NEVER commit the real secrets file to git. Add it to .gitignore.
#   3. Apply: kubectl apply -f k8s/api-secrets.yaml
###############################################################################
apiVersion: v1
kind: Secret
metadata:
  name: orbe-api-secrets
type: Opaque
data:
  # Required
  SECRET_KEY: <BASE64_VALUE>
  ADMIN_USERNAME: <BASE64_VALUE>
  ADMIN_PASSWORD_HASH: <BASE64_VALUE>
  DATABASE_URL: <BASE64_VALUE>

  # Stripe
  STRIPE_SECRET_KEY: <BASE64_VALUE>
  STRIPE_WEBHOOK_SECRET: <BASE64_VALUE>
  STRIPE_PREMIUM_PRICE_ID: <BASE64_VALUE>

  # External
  GEMINI_API_KEY: <BASE64_VALUE>
  GITHUB_TOKEN: <BASE64_VALUE>
  CLOUDINARY_URL: <BASE64_VALUE>

  # Optional
  SIEM_WEBHOOK_URL: <BASE64_VALUE>
  FRONTEND_URL: aHR0cHM6Ly9vcmJlc3lzdGVtcy5jb20uYnI=
